{
	"schemaVersion": 1,
	"id": "toggleable-armour",
	"version": "${version}",
	"name": "Toggleable Armour",
	"description": "This mod lets you toggle armours on and off by Quayru",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://quayru.dev/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/toggleable-armour/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.quayru.toggleablearmour.ToggleableArmour"
		],
		"fabric-datagen": [
			"dev.quayru.toggleablearmour.ToggleableArmourDataGenerator"
		],
		"client": [
			"dev.quayru.toggleablearmour.ToggleableArmourClient"
		]
	},
	"mixins": [
		"toggleable-armour.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}